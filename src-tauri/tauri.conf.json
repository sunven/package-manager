{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevScope",
  "version": "0.1.3",
  "identifier": "com.sunven.package-manager-control-center",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:14201",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DevScope",
        "hiddenTitle": true,
        "width": 1180,
        "height": 760,
        "resizable": false,
        "minWidth": 960,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sunven/package-manager/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyQjM1Q0FFNjcwNkY5NDMKUldSRCtRWm5ybHl6UXUwMGtqdDNuMUQ4M1pnMW1NcHFhOFZBRk56cW9WVllCUnVhWVE3dW1oRW0K"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
